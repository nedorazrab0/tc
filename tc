"""Termux alarm clock."""

from time import ctime, sleep
from subprocess import run
from random import choices
from sys import exit

class MusicPlayer:
    def __init__(self) -> None:
        self.music_cmd = "termux-media-player"

    def play(self) -> None:
        set_volume("1")
        run((self.music_cmd, "play", "./help-me-erin-alarm.ogg"))

    def stop(self) -> None:
        set_volume("0")
        run((self.music_cmd, "stop"))

player = MusicPlayer()

def set_volume(volume_level: str) -> None:
    run(("termux-volume", "music", volume_level))

def wait_for_interupt(secs: float) -> None:
    try:
        sleep(secs)
    except KeyboardInterrupt:
        print_time("Отмена нахуй")
        player.stop()
        run("termux-wake-unlock")
        exit(0)

def vibrate(duration: str) -> None:
    run(("termux-vibrate", "-f", "-d", duration))

def vibrate_pattern(pattern: list) -> None:
    for duration in pattern:
        cmd_duration = str(duration)
        vibrate(cmd_duration)
        wait_for_interupt(duration/1000 + 0.2)

def alarm() -> None:
    print_time("Встаем залупа")
    player.play()
    pattern = choices(range(100, 801, 100), k=64)
    vibrate_pattern(pattern)

def print_time(text: str) -> None:
    print("", text, "", ctime())

def main() -> None:
    secs = float(input("How many minutes until the alarm "))*60
    run(("termux-dialog", "confirm"))
    run("termux-wake-lock")
    vibrate("800")
    print_time("The alarm is set")
    wait_for_interupt(secs)
    alarm()

if __name__ == "__main__":
    main()
